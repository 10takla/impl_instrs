{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Integrate Drafts (Watch)",
      "type": "shell",
      "command": "node",
      "args": ["ai_artifacts/integrate.js", "--watch"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[\\+\\]",
          "endsPattern": "^\\[👁️\\]"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    }
  ]
}
